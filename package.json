{
  "name": "@aifinpay/aifp4-mesh-mvp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AIFP-4 Mesh MVP: local-first payment intents, policy routing, offline queueing, and Solana Devnet settlement proof.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test tests/*.test.mjs",
    "mesh:test": "node --test tests/mesh-integration.test.mjs tests/mesh-protocol.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "devnet:payment": "node scripts/devnet-payment.mjs",
    "ci": "npm run check && npm test"
  },
  "dependencies": {
    "@libp2p/crypto": "5.1.23",
    "@libp2p/identify": "4.1.14",
    "@libp2p/noise": "17.0.3",
    "@libp2p/tcp": "11.0.28",
    "@libp2p/yamux": "8.0.3",
    "@multiformats/multiaddr": "13.0.1",
    "@solana-program/memo": "0.14.1",
    "@solana-program/system": "0.14.1",
    "@solana/kit": "8.3.0",
    "@solana/kit-plugin-rpc": "0.19.0",
    "@solana/kit-plugin-signer": "0.19.0",
    "cborg": "6.1.2",
    "libp2p": "3.3.11"
  }
}
